#  Mosquitto 
# Host ports the two MQTT broker containers are published on.
MOSQUITTO1_HOST_PORT=1883
MOSQUITTO2_HOST_PORT=1884

#  InfluxDB 
INFLUXDB_HOST_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=changeme           # min 8 chars required by InfluxDB
INFLUXDB_TOKEN=changeme              # generate with: openssl rand -base64 32
INFLUXDB_ORG=monitoring-org
INFLUXDB_BUCKET=broker-metrics

#  Agent 
# Internal HTTP port the agent binds on (0.0.0.0:AGENT_HOST_PORT).
# Not published to the host anymore — the gateway is the only external entry point.
AGENT_HOST_PORT=3000

# Path to config and rules files inside the agent container.
CONFIG_PATH=/app/config/config.toml
RULES_PATH=/app/config/rules.toml

# Hostname tag written to InfluxDB metrics (defaults to system hostname if unset).
AGENT_HOSTNAME=

#  Gateway 
# Port the gateway publishes externally (HTTPS in production, HTTP for local dev).
GATEWAY_HOST_PORT=8443

# API key clients must supply in the X-Api-Key header.
# Generate with: openssl rand -base64 32
API_KEY=changeme

# Rate limiting for external API clients (per API key, not per IP).
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20

#  SMTP (alert emails) 
# Gmail example: create an App Password at https://myaccount.google.com/apppasswords
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=changeme

#  Grafana 
GRAFANA_HOST_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme