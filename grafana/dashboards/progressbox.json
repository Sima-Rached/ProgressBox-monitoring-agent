{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "messages / interval",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"broker_metrics\")\n  |> filter(fn: (r) => r.broker_id == \"${broker_id}\")\n  |> filter(fn: (r) => r._field == \"messages_received\" or r._field == \"messages_sent\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> yield(name: \"throughput\")",
          "refId": "A"
        }
      ],
      "title": "Message Throughput \u2014 ${broker_id}",
      "type": "timeseries"
    },
    {
      "type": "gauge",
      "title": "CPU % \u2014 ${broker_id}",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "repeat": "broker_id",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"broker_metrics\")\n  |> filter(fn: (r) => r.broker_id == \"${broker_id}\")\n  |> filter(fn: (r) => r._field == \"cpu_percent\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Memory (MB) \u2014 ${broker_id}",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "repeat": "broker_id",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "min": 0,
          "max": 1024,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 800
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"broker_metrics\")\n  |> filter(fn: (r) => r.broker_id == \"${broker_id}\")\n  |> filter(fn: (r) => r._field == \"mem_usage_mb\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Connected Clients \u2014 ${broker_id}",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "repeat": "broker_id",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "targets": [
        {
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"broker_metrics\")\n  |> filter(fn: (r) => r.broker_id == \"${broker_id}\")\n  |> filter(fn: (r) => r._field == \"clients_connected\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent Alerts",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "id": 5,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "acknowledged"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "\u2705 Acknowledged",
                        "color": "green"
                      },
                      "false": {
                        "text": "\u23f3 Open",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "fired_at",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "type": "json",
          "source": "url",
          "url": "http://gateway:3000/api/v1/alerts",
          "root_selector": "alerts",
          "columns": [
            {
              "selector": "broker_id",
              "text": "Broker",
              "type": "string"
            },
            {
              "selector": "metric",
              "text": "Metric",
              "type": "string"
            },
            {
              "selector": "operator",
              "text": "Op",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "Value",
              "type": "number"
            },
            {
              "selector": "threshold",
              "text": "Threshold",
              "type": "number"
            },
            {
              "selector": "fired_at",
              "text": "Fired At",
              "type": "timestamp_epoch"
            },
            {
              "selector": "acknowledged",
              "text": "acknowledged",
              "type": "string"
            },
            {
              "selector": "id",
              "text": "Alert ID",
              "type": "string"
            }
          ],
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": [
    "progressbox",
    "mqtt",
    "broker"
  ],
