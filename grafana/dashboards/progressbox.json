        "label": "Broker",
        "multi": true,
        "name": "broker_id",
        "options": [],
        "query": "from(bucket: \"broker-metrics\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"broker_metrics\")\n  |> keep(columns: [\"broker_id\"])\n  |> distinct(column: \"broker_id\")\n  |> sort()",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "hide": 2,
        "name": "DS_INFLUXDB",
        "query": "influxdb",
