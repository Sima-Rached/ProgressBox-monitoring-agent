============================================================
SETUP -- constructing agent + gateway stacks (main.rs's job)
============================================================
[agent/main.rs] Config::load("config.toml") -- parsed intervals, brokers, email
[agent/main.rs] RulesConfig::load("rules.toml") -- parsed + validated alert_rules
[agent/main.rs] db::init_db("alerts.db") -- opened SQLite, WAL mode enabled
[agent/main.rs] db::load_all_alerts() -- rehydrated 12 past alerts into memory
[agent/main.rs] instantiated SharedState: Arc<DashMap<broker_id, BrokerMetrics>>
[agent/main.rs] Docker::connect_with_http(docker_host) -- connected via docker-proxy
[agent/main.rs] for broker in config.brokers -> registry::spawn_broker(broker)
                 -- spawns run_mqtt_task() + run_docker_task() per broker
[agent/main.rs] tokio::spawn(influx::spawn_influx_writer())
[agent/main.rs] tokio::spawn(discovery::run_discovery_task(interval=15s))
[agent/main.rs] tokio::spawn(alerts::run_alert_task())
[agent/main.rs] axum::serve() on 0.0.0.0:3000 -- internal only, no auth

[gateway/main.rs] read API_KEY, RATE_LIMIT_PER_SECOND, RATE_LIMIT_BURST from env
[gateway/main.rs] built GovernorConfigBuilder -- rate limiter ready
[gateway/main.rs] Router: /api/v1/* -> require_api_key middleware -> proxy()
[gateway/main.rs] axum::serve() on 0.0.0.0:3000 -- published to host

============================================================
FLOW 1 -- Container is discovered and starts being monitored automatically
============================================================
[docker] operator runs a new mosquitto container with labels:
         progressbox.monitor=true
         progressbox.broker_id=broker-3

[discovery.rs | run_discovery_task()] tick (every 15s)
[discovery.rs | reconcile()] docker.list_containers(filter: monitor label)
                 -- found 3 labeled containers now (was 2)
[discovery.rs | broker_config_from_container()] read labels off broker-3's container
                 -- broker_id="broker-3", resolved container_name via Docker DNS
                 -- mqtt_port label absent -> defaulted to 1883
[discovery.rs] diffed against registry::list_brokers() -- broker-3 NOT registered
[discovery.rs] registry::is_suppressed("broker-3") -- false, not manually deleted
[discovery.rs] "found new broker 'broker-3', registering"
[registry.rs | spawn_broker()] stop_broker_internal() first -- no-op (nothing to replace)
[registry.rs] tokio::spawn(mqtt::run_mqtt_task(broker-3, ...))
[registry.rs] tokio::spawn(docker::run_docker_task(broker-3, ...))
[registry.rs] registry.insert("broker-3", [handle1, handle2])
[discovery.rs] mark_discovered("broker-3") -- tracked so future removal is allowed

[mqtt.rs | run_mqtt_task(broker-3)] MQTT connects, subscribes $SYS/#
[docker.rs | run_docker_task(broker-3)] first docker.stats() call succeeds
    -> broker-3 now appears in GET /metrics with zero operator intervention

============================================================
FLOW 2 -- Container disappears, discovery cleans it up automatically
============================================================
[docker] operator stops/removes broker-3's container

[discovery.rs | reconcile()] tick -- broker-3 no longer in list_containers() result
[discovery.rs] currently_registered still contains "broker-3"
[discovery.rs] was_previously_discovered("broker-3") -- true (marked in Flow 1)
[discovery.rs] "broker 'broker-3' no longer present, deregistering"
[registry.rs | stop_broker_no_suppress()] -- NOT suppressed, so it can
                 come back later and be treated as genuinely new
[registry.rs | stop_broker_internal()] handles.abort() x2 -- both tasks killed
                 state.remove("broker-3") -- entry wiped from SharedState
[discovery.rs] unmark_discovered("broker-3")

[http.rs | get_metrics()] next poll -- broker-3 is simply absent from the
                 response, not shown as "stale" or "offline"
    -> confirms the removal was clean: no ghost entries, no leaked tasks

============================================================
FLOW 3 -- Operator manually deletes a broker, discovery respects it
============================================================
[operator] DELETE /api/v1/brokers/broker-2  (via gateway, x-api-key required)

[gateway/main.rs] require_api_key -- PASS
[gateway/main.rs] proxy() -- forwarded to http://agent:3000/brokers/broker-2
                 -- NOTE: this route only exists internally; the gateway
                    does not expose broker mutation routes by design, so
                    in practice this call has to originate inside the
                    docker network, not from the public internet

[http.rs | delete_broker()] registry::stop_broker("broker-2", ...)
[registry.rs | stop_broker()] stop_broker_internal() -- tasks aborted, state cleared
[registry.rs] suppress("broker-2") -- added to the process-global suppressed set
[http.rs] returned 204 No Content

--- 15 seconds later, discovery runs again ---
[discovery.rs | reconcile()] broker-2's container is STILL running and
                 STILL labeled progressbox.monitor=true
[discovery.rs] broker-2 discovered but NOT in currently_registered
[discovery.rs] registry::is_suppressed("broker-2") -- TRUE
[discovery.rs] "broker 'broker-2' is suppressed (manually deleted), not re-registering"
    -> the manual delete sticks, even though the label never went away

--- later still, the container is finally removed ---
[discovery.rs | reconcile()] broker-2 no longer in discovered set at all
[discovery.rs] "suppressed broker 'broker-2' no longer labeled/present,
                 clearing suppression"
[registry.rs | unsuppress()] removed from suppressed set
    -> if a NEW container reuses id "broker-2" later, it will be treated
       as brand new, not blocked by the old manual delete

============================================================
FLOW 4 -- Alert fires, is rate-gated by cooldown, then acknowledged
============================================================
[alerts.rs | run_alert_task()] tick (every mqtt_scrape_secs)
[alerts.rs] rules_store.read().await.clone() -- snapshot of current rules
[alerts.rs] for broker-1, rule{ metric: mem_usage_mb, op: ">", threshold: 512.0 }
                 SharedState value = 640.2 -- breached = true
[alerts.rs] cooldown_key = "broker-1:mem_usage_mb"
                 cooldowns.get(key) -- none found -- NOT suppressed
                 cooldowns.insert(key, Instant::now())
[alerts.rs] FiredAlert{ id: uuid_a, broker_id: "broker-1", value: 640.2, ... }
[db.rs | insert_alert()] spawn_blocking -- persisted to alerts.db
[alerts.rs] alert_store.lock().push(alert) -- also kept in memory
[alerts.rs] lettre::Message built, spawn_blocking(mailer.send()) -- SMTP sent
[agent stdout] "[ALERT] email sent to ops@example.com"

--- 10s later, still breached ---
[alerts.rs] tick -- breached = true again
                 cooldowns.get(key) -- last_fired 10s ago < cooldown_secs(30)
                 SUPPRESSED -- no second DB row, no second email

--- operator acknowledges it via the API ---
[operator] curl -X PATCH /api/v1/alerts/uuid_a/acknowledge
[gateway/main.rs] require_api_key -- PASS -> proxy() -> agent
[http.rs | patch_alert_acknowledge()] spawn_blocking(db::acknowledge_alert(uuid_a))
[db.rs] UPDATE alerts SET acknowledged = 1 WHERE id = uuid_a -- 1 row updated
[http.rs] found alert in in-memory alert_store, flipped .acknowledged = true too
                 -- keeps SQLite and the in-memory copy in sync
[http.rs] returned 200 { id: uuid_a, acknowledged: true }

--- 20s later, still breached, cooldown now expired ---
[alerts.rs] tick -- breached = true, cooldown(30s) has elapsed since last_fired
                 NOT suppressed -- fires again as a NEW alert (new uuid)
    -> acknowledging one firing does not silence future breaches; the
       cooldown, not the ack, is what controls repeat frequency
