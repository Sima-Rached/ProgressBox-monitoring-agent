============================================================
FLOW 5 -- Startup fails fast on bad config / missing secrets
============================================================
[agent/main.rs] dotenvy::dotenv().ok() -- loaded .env (best-effort, ignored if missing)
[agent/main.rs] CONFIG_PATH env var not set -- defaulted to "config.toml"
[config.rs | Config::load("config.toml")] fs::read_to_string() -- file found
[config.rs] toml::from_str::<ConfigRaw>() -- parsed successfully
                 -- structure is valid, but secrets still need to come from env

[config.rs | Config::load()] std::env::var("SMTP_USERNAME") -- MISSING
                 -- operator forgot to set it (or .env wasn't mounted in
                    this deployment, e.g. a fresh clone without secrets)
[config.rs] returned Err("missing env var SMTP_USERNAME")

[agent/main.rs] match Config::load(...) { Err(e) => ... }
[agent stdout] "Config error: missing env var SMTP_USERNAME"
[agent/main.rs] std::process::exit(1)
    -> process terminates BEFORE any task is spawned, before the HTTP
       server binds, before Docker is even touched -- nothing partially
       starts in a broken state

--- separately: rules.toml has an invalid rule ---
[agent/main.rs] (assume SMTP_USERNAME now set, config loads fine)
[config.rs | RulesConfig::load("rules.toml")] toml::from_str::<RulesFile>() -- parsed
[config.rs] for (i, rule) in parsed.alert_rules.iter().enumerate():
                 rule.validate(i) -- rule[1].metric = "cpu_usage" (typo)
[config.rs | AlertRule::validate()] "cpu_usage" not in VALID_METRICS
[config.rs] returned Err("alert_rules[1]: unknown metric 'cpu_usage' (valid: ...)")

[agent/main.rs] match RulesConfig::load(...) { Err(e) => ... }
[agent stdout] "Rules error: alert_rules[1]: unknown metric 'cpu_usage' (valid: ...)"
[agent/main.rs] std::process::exit(1)
    -> same fail-fast behavior at STARTUP time; contrast this with FLOW 2
       from before (POST /reload), which rejects a bad file at RUNTIME
       and keeps the OLD rules active instead of crashing -- startup has
       no "old rules" to fall back to, so it has to refuse to boot instead

--- Docker connection failure (not config-related) ---
[agent/main.rs] (config + rules now valid)
[agent/main.rs] Docker::connect_with_http(docker_host, 120, API_DEFAULT_VERSION)
                 -- docker-proxy container not yet up / unreachable
[agent/main.rs] .expect("failed to connect to Docker via docker-proxy")
[agent stdout] thread 'main' panicked at 'failed to connect to Docker via
                docker-proxy: ...'
    -> unlike the config/rules errors, this is an unrecoverable .expect(),
       not a handled Result -- worth flagging as a place where a graceful
       error message (like the config path) would be a nicer failure mode
       than a raw panic; depends on docker-proxy's depends_on ordering in
       docker-compose.yml actually being respected at container start
